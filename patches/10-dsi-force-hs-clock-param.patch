diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 982abaaac00..3381c434090 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/clk.h>
+#include <linux/module.h>
 #include <linux/delay.h>
 #include <linux/dma-mapping.h>
 #include <linux/err.h>
@@ -2425,6 +2426,18 @@ void msm_dsi_host_disable_irq(struct mipi_dsi_host *host)
 	disable_irq(msm_host->irq);
 }
 
+/*
+ * Panels that need a non-continuous clock to come up (the host is powered
+ * before the panel and a continuous HS clock during the panel's power-on
+ * reset breaks it) may still want the clock lane in HS while video runs,
+ * the way downstream drivers with force_clk_lane_hs did. Switchable at
+ * runtime; takes effect on the next enable.
+ */
+static bool dsi_force_hs_clk;
+module_param_named(dsi_force_hs_clk, dsi_force_hs_clk, bool, 0644);
+MODULE_PARM_DESC(dsi_force_hs_clk,
+		 "Force a continuous HS clock while video runs on non-continuous-clock panels (default: false)");
+
 int msm_dsi_host_enable(struct mipi_dsi_host *host)
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
@@ -2432,6 +2445,12 @@ int msm_dsi_host_enable(struct mipi_dsi_host *host)
 	dsi_op_mode_config(msm_host,
 		!!(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO), true);
 
+	if (dsi_force_hs_clk &&
+	    (msm_host->mode_flags & MIPI_DSI_CLOCK_NON_CONTINUOUS))
+		dsi_write(msm_host, REG_DSI_LANE_CTRL,
+			  dsi_read(msm_host, REG_DSI_LANE_CTRL) |
+			  DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
+
 	/* TODO: clock should be turned off for command mode,
 	 * and only turned on before MDP START.
 	 * This part of code should be enabled once mdp driver support it.
@@ -2450,6 +2469,13 @@ int msm_dsi_host_disable(struct mipi_dsi_host *host)
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
 
 	msm_host->enabled = false;
+
+	/* Back to the panel's own clock mode before the next power-on. */
+	if (msm_host->mode_flags & MIPI_DSI_CLOCK_NON_CONTINUOUS)
+		dsi_write(msm_host, REG_DSI_LANE_CTRL,
+			  dsi_read(msm_host, REG_DSI_LANE_CTRL) &
+			  ~DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
+
 	dsi_op_mode_config(msm_host,
 		!!(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO), false);
 
