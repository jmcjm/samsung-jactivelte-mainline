diff --git a/drivers/cpufreq/Kconfig.arm b/drivers/cpufreq/Kconfig.arm
index 47c9b031f..52694ee90 100644
--- a/drivers/cpufreq/Kconfig.arm
+++ b/drivers/cpufreq/Kconfig.arm
@@ -150,6 +150,17 @@ config ARM_QCOM_CPUFREQ_NVMEM
 	help
 	  This adds the CPUFreq driver for Qualcomm Kryo SoC based boards.
 
+config KRAIT_UV
+	tristate "Runtime CPU operating point voltage adjustment"
+	depends on PM_OPP
+	help
+	  Exposes /sys/kernel/krait_uv to change the voltage of the CPU
+	  operating points on a running system, for undervolting experiments
+	  on Qualcomm Krait boards driven by cpufreq-dt. Unloading the module
+	  restores the device tree voltages.
+
+	  If in doubt, say N.
+
 	  If in doubt, say N.
 
 config ARM_QCOM_CPUFREQ_HW
