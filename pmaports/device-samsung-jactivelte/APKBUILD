# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-samsung-jactivelte
pkgver=0.1
pkgrel=0
pkgdesc="Samsung Galaxy S4 Active"
url="https://postmarketos.org"
arch="armv7"
license="MIT"
depends="
	firmware-qcom-adreno-a300
	firmware-samsung-jflte
	linux-firmware-brcm
	linux-postmarketos-qcom-apq8064
	mkbootimg
	msm-firmware-loader
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	90-jactivelte-keys.rules
	adreno-a3xx-quirks.sh
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/adreno-a3xx-quirks.sh \
		"$pkgdir"/etc/profile.d/adreno-a3xx-quirks.sh

	install -Dm644 "$srcdir"/90-jactivelte-keys.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-jactivelte-keys.rules
}

